#!/bin/bash
#PBS -N TabPFN_PeerNode_Grid
#PBS -l select=1:ncpus=16:mem=64gb
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -M your_email@unsw.edu.au
#PBS -m ae

# ==========================================
# Katana PBS Job Script for TabPFN Grid Search
# ==========================================

# Print job information
echo "Starting job $PBS_JOBID at $(date)"
echo "Running on node: $(hostname)"
echo "Number of CPUs allocated: $PBS_NCPUS"

# Move to the directory where the job was submitted
cd $PBS_O_WORKDIR
echo "Current working directory is $PWD"

# Load Python module (Katana standard)
module load python/3.10.8

# Activate local virtual environment
source venv/bin/activate

# Set TabPFN Token (REPLACE THIS WITH YOUR ACTUAL KEY)
export TABPFN_TOKEN="tabpfn_sk_UPwvEP4TwpM-91a2H_ImqvHzfn8scwNkp66AZrKEDhs"

# Run the python script
# The script will automatically detect $PBS_NCPUS and parallelize using joblib
python run_peer_node_simulations.py

echo "Job finished at $(date)"
